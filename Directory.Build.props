<Project>

  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591</WarningsNotAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NeutralLanguage>en</NeutralLanguage>
    <Authors>Milad AT8</Authors>
    <Company>Milad AT8</Company>
    <Product>AI Chat RTL Fixer</Product>
    <Copyright>Copyright (c) 2026 Milad AT8</Copyright>
    <!-- Keep file/product version clean (no +git-hash suffix) so it matches
         the installer and the About dialog exactly. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/miladateight/AI.Chat.RTL.Fixer</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <Version>1.0.4</Version>
    <AssemblyVersion>1.0.4.0</AssemblyVersion>
    <FileVersion>1.0.4.0</FileVersion>
  </PropertyGroup>

  <!-- Runtime footprint. This tool only ever compares strings ordinally and
       logs with InvariantCulture, so it does not need ICU: dropping it removes
       ~28 MB of unpacked globalization data and lowers memory. Workstation,
       non-concurrent GC keeps the resident set small for a mostly-idle tray
       process instead of pre-reserving background-GC heaps. -->
  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
  </PropertyGroup>

</Project>
