<?xml version="1.0" encoding="utf-8"?>
<!--
  Framework-dependent publish profile.
  Produces a small single-file EXE; requires the .NET 8 Desktop Runtime to be
  installed on the target machine.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>win-x64</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <ReadyToRun>false</ReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishDir>bin\Release\publish\framework-dependent</PublishDir>
  </PropertyGroup>
</Project>