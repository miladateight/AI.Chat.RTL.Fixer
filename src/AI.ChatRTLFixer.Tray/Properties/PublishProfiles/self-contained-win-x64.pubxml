<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained publish profile.
  Produces a single-file EXE that bundles the .NET 8 runtime, so the user does
  NOT need to install the .NET 8 Desktop Runtime separately. Larger than the
  framework-dependent build, but zero prerequisites.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>win-x64</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <ReadyToRun>false</ReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDir>bin\Release\publish\self-contained-win-x64</PublishDir>
  </PropertyGroup>
</Project>